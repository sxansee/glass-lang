<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===================== Палитра ===================== -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F2F4F8" />
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PanelHeaderBrush" Color="#E9EEF5" />
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#D3DAE5" />
    <SolidColorBrush x:Key="CanvasBackgroundBrush" Color="#FAFBFD" />
    <SolidColorBrush x:Key="TextBrush" Color="#1F2937" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#6B7788" />
    <SolidColorBrush x:Key="AccentBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#E4EDFE" />
    <SolidColorBrush x:Key="RefBrush" Color="#6D3FC4" />
    <SolidColorBrush x:Key="GarbageBrush" Color="#D64545" />
    <SolidColorBrush x:Key="GarbageSoftBrush" Color="#FDECEC" />
    <SolidColorBrush x:Key="GarbageHeaderBrush" Color="#F8D5D5" />
    <SolidColorBrush x:Key="NewBrush" Color="#15803D" />
    <SolidColorBrush x:Key="NewSoftBrush" Color="#E3F6EA" />
    <SolidColorBrush x:Key="ChangedBrush" Color="#B45309" />
    <SolidColorBrush x:Key="ChangedSoftBrush" Color="#FFF1D6" />
    <SolidColorBrush x:Key="ObjectHeaderBrush" Color="#E3ECFB" />
    <SolidColorBrush x:Key="ArrayHeaderBrush" Color="#DDF3E5" />
    <SolidColorBrush x:Key="NodeBorderBrush" Color="#9AA9BE" />
    <SolidColorBrush x:Key="EdgeBrush" Color="#7487A3" />
    <SolidColorBrush x:Key="SlotIntBrush" Color="#3B82F6" />
    <SolidColorBrush x:Key="SlotDoubleBrush" Color="#0D9488" />
    <SolidColorBrush x:Key="SlotBoolBrush" Color="#D97706" />
    <SolidColorBrush x:Key="SlotRefBrush" Color="#8B5CF6" />

    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Courier New</FontFamily>

    <!-- ===================== Панели ===================== -->
    <Style x:Key="PanelBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PanelBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="PanelHeader" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PanelHeaderBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="CornerRadius" Value="5,5,0,0" />
        <Setter Property="Padding" Value="10,5" />
    </Style>

    <Style x:Key="PanelTitle" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="#3A4656" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="#3A4656" />
        <Setter Property="Margin" Value="0,14,0,6" />
    </Style>

    <Style x:Key="MutedText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="MonoText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="MonoMutedText" TargetType="TextBlock" BasedOn="{StaticResource MonoText}">
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
    </Style>

    <Style x:Key="HintText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="MaxWidth" Value="360" />
        <Setter Property="Margin" Value="24" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <!-- ===================== Значки панели инструментов ===================== -->
    <Geometry x:Key="IconPlay">M 4,2.5 L 13,8 L 4,13.5 Z</Geometry>
    <Geometry x:Key="IconStop">M 3.5,3.5 L 12.5,3.5 L 12.5,12.5 L 3.5,12.5 Z</Geometry>
    <Geometry x:Key="IconStepInto">M 8,1.5 L 8,9.5 M 4.5,6.5 L 8,10 L 11.5,6.5 M 6.8,13.6 A 1.2,1.2 0 1 1 9.2,13.6 A 1.2,1.2 0 1 1 6.8,13.6</Geometry>
    <Geometry x:Key="IconStepOver">M 2.5,9 C 2.5,2.5 13.5,2.5 13.5,9 M 11.3,7.3 L 13.5,9.5 L 15.5,7.3 M 6.8,13.6 A 1.2,1.2 0 1 1 9.2,13.6 A 1.2,1.2 0 1 1 6.8,13.6</Geometry>
    <Geometry x:Key="IconStepOut">M 8,10 L 8,2 M 4.5,5.5 L 8,2 L 11.5,5.5 M 6.8,14.4 A 1.2,1.2 0 1 1 9.2,14.4 A 1.2,1.2 0 1 1 6.8,14.4</Geometry>
    <Geometry x:Key="IconTrash">M 3.5,4.5 L 12.5,4.5 M 6,4.5 L 6,2.5 L 10,2.5 L 10,4.5 M 4.5,4.5 L 5.2,13.5 L 10.8,13.5 L 11.5,4.5 M 7,7 L 7,11 M 9,7 L 9,11</Geometry>
    <Geometry x:Key="IconCourse">M 2,3.5 C 4.5,2.6 6.6,2.8 8,4 C 9.4,2.8 11.5,2.6 14,3.5 L 14,12.5 C 11.5,11.6 9.4,11.8 8,13 C 6.6,11.8 4.5,11.6 2,12.5 Z M 8,4 L 8,13</Geometry>
    <EllipseGeometry x:Key="IconBreakpoint" Center="8,8" RadiusX="5" RadiusY="5" />

    <Style x:Key="ToolIcon" TargetType="Path">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="StrokeThickness" Value="1.6" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Style.Triggers>
            <!-- IsEnabled наследуется от кнопки: недоступная команда — блёклый значок -->
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.35" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===================== Прочее ===================== -->
    <Style x:Key="Banner" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource ChangedSoftBrush}" />
        <Setter Property="BorderBrush" Value="#F1CF8E" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="Visibility" Value="Collapsed" />
    </Style>

    <Style x:Key="StateDot" TargetType="Ellipse">
        <Setter Property="Width" Value="10" />
        <Setter Property="Height" Value="10" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Fill" Value="#9AA7B8" />
    </Style>

</ResourceDictionary>
