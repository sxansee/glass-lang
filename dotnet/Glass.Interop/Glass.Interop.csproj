<Project Sdk="Microsoft.NET.Sdk">

  <!-- Переносимая библиотека (net8.0, без WPF): P/Invoke-мост к glass_capi.
       Собирается и тестируется и на Linux, и на Windows — это сознательно,
       чтобы всё, что можно проверить без WPF, проверялось по-настоящему. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Glass.Interop</RootNamespace>
    <AssemblyName>Glass.Interop</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>12.0</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
