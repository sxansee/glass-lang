// Сборка мусора: объекты, на которые больше никто не ссылается.
//
// В IDE: шагайте по строкам (F10) и следите за схемой кучи.
//  1. После `a = b` объект Box(1) теряет последнюю ссылку — он помечается
//     как мусор (красный пунктир): он ещё в куче, но уже недостижим.
//  2. `~gc` (или кнопка «Собрать мусор») освобождает его — узел исчезает.
mold Box {
    let value: int

    Box(v: int) {
        value = v
    }
}

fn main() {
    let a = Box(1)
    let b = Box(2)
    a = b
    ~gc
    print(~heap)
}
