// Преобразование типов и вывод нескольких значений.
fn main() {
    let text = "21"
    let n = int(text) * 2            // строку — в число
    print("n =", n)                  // print принимает любые типы, через запятую
    print("Ответ: " + n)             // число рядом со строкой само становится текстом
    print(int(3.99), double(7) / 2)  // дробная часть отбрасывается; 7 → 7.0
    let d: double = 5                // int сам превращается в double
    print(d / 2)
    print((int) 3.7, (string) 12 + "!")
    print(bool("true"), bool(0))
}
